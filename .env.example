# ===============================
# 🌐 Environment Configuration
# ===============================
NODE_ENV=development        # Hoặc production / test
PORT=3000                   # Cổng mà backend sẽ chạy

# ===============================
# 🗄️ Database Configuration
# ===============================
DATABASE_URL="mysql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>"

# Ví dụ thực tế:
# DATABASE_URL="mysql://root:password@localhost:3306/olympicdev"

# ===============================
# 🔐 JWT Configuration
# ===============================
JWT_SECRET=your_jwt_secret_key_must_be_long_enough
JWT_EXPIRES_IN=1h                 # Thời gian hết hạn access token
JWT_REFRESH_EXPIRES_IN=30d       # Thời gian hết hạn refresh token

# ===============================
# 🔓 CORS Configuration
# ===============================
CORS_ORIGIN=http://localhost:5173   # URL frontend (React/Vite/Next.js...)

# ===============================
# 🚀 API Configuration
# ===============================
API_URL=http://localhost:5000       # URL gọi từ frontend về backend (nếu cần)

# ===============================
# 📝 Logging Configuration
# ===============================
LOG_LEVEL=info                      # info | debug | warn | error

# ===============================
# 👤 Admin Account (for first login/setup)
# ===============================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123
ADMIN_EMAIL=admin@example.com

# ===============================
# 📧 Email (SMTP) Configuration
# ===============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
